---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { PERIODS, DEFAULT_PERIOD } from "../lib/period.ts";

// Whose listening history the map shows by default. A `?user=` parameter
// overrides it, which is most of what a "show me mine" control will need.
const DEFAULT_USER = "NestorDHCP";
---

<BaseLayout>
  <SiteHeader />

  <main class="app" id="map">
    <!-- ─── The map ─── -->
    <div class="stage" id="stage" data-state="loading" data-default-user={DEFAULT_USER}>
      <canvas id="canvas" class="stage__canvas"></canvas>

      <!-- Lightweight hover/focus feedback before committing to a click (REQ-20) -->
      <div class="tip" id="tip" role="presentation" hidden></div>

      <noscript>
        <div class="stage__veil">
          <div class="veil__inner">
            <p class="quiet">
              The map is built and drawn in the browser, so it needs
              JavaScript. The short version: the 300 artists I have played
              most on Last.fm, sized by how much I have played them and
              placed next to the artists the data says they are most alike.
            </p>
          </div>
        </div>
      </noscript>

      <!-- Loading / empty / error (REQ-23, REQ-24) -->
      <div class="stage__veil" id="veil">
        <div class="veil__inner">
          <div class="veil__pulse" aria-hidden="true"></div>
          <p class="quiet" id="veil-text" role="status">Reading the scrobbles…</p>
          <p class="quiet veil__sub" id="veil-sub" hidden></p>
          <button type="button" class="veil__retry" id="veil-retry" hidden>
            Try another account
          </button>
        </div>
      </div>

      <!-- ─── Controls ─── -->
      <div class="controls">
        <div class="finder" id="finder">
          <label class="sr-only" for="search">Find an artist</label>
          <input
            id="search"
            class="finder__input"
            type="search"
            placeholder="Find an artist…"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-controls="results"
            aria-autocomplete="list"
          />
          <ul class="finder__results" id="results" role="listbox" aria-label="Matching artists" hidden></ul>
        </div>

        <!--
          The rolling period (TP-REQ-3): always visible, never behind a
          settings panel, and never showing Last.fm's own names for these
          windows (TP-REQ-2). "Explore over time" sits apart from it on
          purpose — "12 months" and "2025" are not two options of the same
          kind (§33).
        -->
        <div class="periods" id="periods" role="group" aria-label="Listening period">
          {PERIODS.map((p) => (
            <button
              type="button"
              class={`period${p.value === DEFAULT_PERIOD ? " is-on" : ""}`}
              data-period={p.value}
              aria-pressed={p.value === DEFAULT_PERIOD ? "true" : "false"}
              title={`Rebuild the map from ${p.value === "overall" ? "the whole history" : p.phrase}`}
            >
              <span aria-hidden="true">{p.short}</span>
              <span class="sr-only">{p.label}</span>
            </button>
          ))}
          <button
            type="button"
            class="period period--timeline"
            id="timeline-enter"
            aria-pressed="false"
            title="Move through this account's listening year by year"
          >Explore over time →</button>
        </div>

        <div class="zoom" role="group" aria-label="Zoom and view">
          <button type="button" class="zoom__btn" id="zoom-out" aria-label="Zoom out">−</button>
          <button type="button" class="zoom__btn" id="zoom-in" aria-label="Zoom in">+</button>
          <button type="button" class="zoom__btn zoom__btn--wide" id="reset" title="Reset the view">
            reset
          </button>
        </div>
      </div>

      <!-- ─── Cluster legend (auto-derived, see §method) ─── -->
      <div class="legend" id="legend" hidden>
        <button
          type="button"
          class="legend__toggle"
          id="legend-toggle"
          aria-expanded="false"
          aria-controls="legend-body"
        >
          <span class="legend__title">Groups</span>
          <span class="legend__chev" aria-hidden="true">▸</span>
        </button>
        <div class="legend__body" id="legend-body" hidden>
          <p class="legend__note">
            Colours mark groups the similarity data fell into on its own. Each
            name is the tag most distinctive to that group's artists — a
            description of what landed there, not a label anything was sorted
            by.
          </p>
          <ul class="legend__list" id="legend-list"></ul>
        </div>
      </div>

      <!--
        The keyboard/screen-reader route through the map (REQ-22). Every
        bubble also exists here as a real button: focusing one pans the map
        to it and outlines it, activating one opens the same detail panel a
        click would. Visually hidden so the canvas stays the visual language,
        and placed after the controls so a keyboard user meets the search box
        before three hundred artists.
      -->
      <div class="stage__a11y">
        <h2 class="sr-only" id="a11y-heading">Artists on the map</h2>
        <p class="sr-only">
          A spatial map of artists. Bubbles sit near the artists they are
          similar to; the horizontal and vertical directions carry no meaning
          on their own. Moving through this list pans the map to each artist
          in turn; activating one opens its details. Searching by name is
          usually quicker — the search box is just before this list.
        </p>
        <ul class="sr-only" id="a11y-list" aria-labelledby="a11y-heading"></ul>
      </div>

      <!-- ─── Detail panel (REQ-14/15) ─── -->
      <aside class="detail" id="detail" tabindex="-1" aria-label="Artist detail" hidden></aside>
    </div>

    <!--
      The one thing spoken aloud. The caption ticks over every fifteen
      artists while a graph builds and every frame while the timeline plays;
      that is progress worth seeing and not worth hearing (TP-REQ-25,
      TE-REQ-32/33).
    -->
    <p class="sr-only" id="live" role="status" aria-live="polite"></p>

    <!-- ─── Taste Evolution controls (§29) ─── -->
    <div class="timeline" id="timeline" hidden>
      <div class="timeline__bar">
        <div class="timeline__transport" role="group" aria-label="Move through time">
          <button type="button" class="timeline__btn" id="timeline-prev" aria-label="Previous year">◀</button>
          <button type="button" class="timeline__btn timeline__btn--play" id="timeline-play" aria-pressed="false">▶ Play</button>
          <button type="button" class="timeline__btn" id="timeline-next" aria-label="Next year">▶</button>
        </div>
        <ul class="timeline__frames" id="timeline-frames" aria-label="Years"></ul>
        <button type="button" class="timeline__exit" id="timeline-exit">Exit timeline</button>
      </div>
      <p class="timeline__status quiet" id="timeline-status"></p>
      <div class="timeline__summary" id="timeline-summary"></div>
    </div>

    <!-- ─── Caption strip: what you're looking at (REQ-3, REQ-25) ─── -->
    <div class="caption">
      <p class="caption__scope" id="caption-scope">&nbsp;</p>
      <p class="caption__meta">
        <span id="caption-asof"></span>
        <button type="button" class="caption__link" id="account-open">
          Map another account
        </button>
        <button
          type="button"
          class="caption__link"
          id="about-toggle"
          aria-expanded="false"
          aria-controls="about"
        >How this map works</button>
      </p>
    </div>

    <!--
      Whose map to draw. Any public Last.fm account works, because
      user.getTopArtists is a public read — there is nothing to sign in to
      and nothing leaves the browser.
    -->
    <dialog class="account" id="account">
      <form method="dialog" class="account__form" id="account-form">
        <h2 class="account__h">Whose listening history?</h2>
        <p class="account__note">
          Any public Last.fm account. There is no sign-in — the map is built
          in your browser from the same public data the profile page shows.
        </p>

        <label class="sr-only" for="account-input">Last.fm username</label>
        <input
          class="account__input"
          id="account-input"
          name="user"
          type="text"
          placeholder="Last.fm username"
          autocomplete="username"
          spellcheck="false"
          autocapitalize="none"
          required
        />
        <p class="account__error" id="account-error" role="alert" hidden></p>

        <div class="account__recent" id="account-recent" hidden>
          <p class="account__recent-head">Already in this browser's cache</p>
          <ul class="account__recent-list" id="account-recent-list"></ul>
        </div>

        <div class="account__actions">
          <button type="button" class="account__btn" id="account-cancel">
            Cancel
          </button>
          <button type="submit" class="account__btn account__btn--go">
            Show this map
          </button>
        </div>
      </form>
    </dialog>

    <!-- ─── Method note ─── -->
    <section class="about" id="about" hidden aria-label="How this map works">
      <div class="about__inner">
        <h2 class="about__h">How this map works</h2>
        <dl class="about__dl">
          <dt>What's on it</dt>
          <dd id="about-scope"></dd>

          <dt>How big a bubble is</dt>
          <dd>
            Bubble size follows how much this account has actually listened to
            that artist — their own scrobble count, not the artist's
            popularity — counted inside whichever period is selected above, or
            inside the selected year in the timeline. Never a lifetime total
            shown on a map of one month. The scale is logarithmic, so an artist
            with a few dozen plays is still visible next to one with several
            thousand.
          </dd>

          <dt>Why bubbles sit where they sit</dt>
          <dd>
            Each artist is linked to the artists Last.fm's own listening data
            says they are most alike. Those links pull artists together, every
            other pair pushes apart, and the whole thing is relaxed until
            nothing overlaps. Nobody sorted anyone into a genre first — open
            any bubble and it will show you the specific artists it was pulled
            toward, and how strong each of those links is.
          </dd>

          <dt>What the directions mean</dt>
          <dd>
            Nothing. Only the distance between two bubbles carries meaning:
            near means similar. Left, right, up and down are just where the
            simulation settled, and the whole map could be rotated without
            losing any information.
          </dd>

          <dt>The colours</dt>
          <dd>
            Groups are found by passing labels around the same similarity
            links until they settle — an outcome of the data, not a set of
            buckets defined in advance. Each group's name is simply the
            Last.fm tag most distinctive to the artists that landed in it.
            Grey bubbles are artists with no strong tie to anything else here.
          </dd>

          <dt>Moving through time</dt>
          <dd>
            The period buttons rebuild the map from one of Last.fm's rolling
            windows — the last week, month, three months, six months, year, or
            the whole history. Bubble size is always plays inside the window
            you picked, never lifetime plays.
            <br /><br />
            "Explore over time" is a different thing. Last.fm cannot report an
            arbitrary calendar year, so those years are reconstructed from its
            weekly charts: one chart per week, added up. A week that straddles
            New Year is counted whole, in whichever year contains the middle
            of that week — so the boundaries follow Last.fm's own weekly
            granularity rather than the calendar exactly. Positions, groups and
            colours are worked out once for the whole timeline and then held
            still: when a year changes, what changes is how much each artist
            was played, because that is the only thing that actually changed.
          </dd>

          <dt>Where it comes from</dt>
          <dd id="about-fresh"></dd>
        </dl>
        <p class="about__foot">
          Data from <a href="https://www.last.fm/api" target="_blank" rel="noopener noreferrer">Last.fm</a>,
          read with the same public, read-only key the
          <a id="about-music" href="https://nelson-j.ch/music" target="_top">/music</a>
          page uses. <a id="about-profile" href="https://www.last.fm/user/NestorDHCP" target="_blank" rel="noopener noreferrer">Profile ↗</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { start } from "../scripts/map.ts";
  start();
</script>
